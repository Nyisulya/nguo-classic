{
  "name": "vazivibe-boutique-backend",
  "version": "1.0.0",
  "description": "Backend and management scripts for VaziVibe Boutique clothing store",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix frontend",
